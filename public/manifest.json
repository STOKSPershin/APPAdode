{
  "manifest_version": 3,
  "name": "StockBooster — TopicHunter",
  "version": "1.6.2",
  "description": "Discover high-demand subtopics for Adobe Stock. AI-powered research with real-time demand validation.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "TopicHunter"
  },

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://stock.adobe.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "alarms"
  ],

  "host_permissions": [
    "https://api.openai.com/*",
    "https://stock.adobe.com/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
